		{
			"name": "7. Abrir Ordem de Serviço",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Lista de problemas possíveis",
							"const problemas = [",
							"    \"Barulho na suspensão traseira\",",
							"    \"Ruído no motor\",",
							"    \"Freio com pouca eficiência\",",
							"    \"Luz da injeção acesa\",",
