		{
			"name": "3. Cadastrar Mecânico",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Função para gerar CPF válido",
							"function gerarCpf() {",
							"    let cpfArray;",
							"    do {",
							"        const nums = [];",
							"        for (let i = 0; i < 9; i++) {",
							"            nums.push(Math.floor(Math.random() * 10));",
							"        }",
							"        const dig1 = calcularDigito(nums);",
							"        const dig2 = calcularDigito([...nums, dig1]);",
							"        cpfArray = [...nums, dig1, dig2];",
							"    } while (cpfArray.every(d => d === cpfArray[0])); // evita sequências repetidas",
							"    return cpfArray.join('');",
							"}",
							"",
							"function calcularDigito(digs) {",
							"    let soma = 0;",
							"    for (let i = 0; i < digs.length; i++) {",
							"        soma += digs[i] * ((digs.length + 1) - i);",
							"    }",
							"    const resto = soma % 11;",
							"    return resto < 2 ? 0 : 11 - resto;",
							"}",
							"",
							"// Lista de especialidades conforme enum",
							"const especialidades = [\"MOTORES\", \"SUSPENSAO\", \"ELETRICA\", \"GERAL\"];",
							"",
							"// Lista de nomes possíveis para mecânicos",
							"const nomes = [",
							"    \"Mestre Ioda\",",
							"    \"Carlos Mecânico\",",
							"    \"Ana Torres\",",
							"    \"Pedro Souza\",",
							"    \"Mariana Lima\",",
							"    \"Roberto Santos\",",
							"    \"Fernanda Oliveira\",",
							"    \"João Batista\"",
							"];",
							"",
							"// Gera registro funcional simples (prefixo + número aleatório)",
							"function gerarRegistro() {",
							"    const numero = Math.floor(Math.random() * 900) + 100; // entre 100 e 999",
							"    return \"MF-\" + numero;",
							"}",
							"",
							"// Define variáveis na collection",
							"pm.collectionVariables.set(\"nome_mecanico\", nomes[Math.floor(Math.random() * nomes.length)]);",
							"pm.collectionVariables.set(\"cpf_mecanico\", gerarCpf());",
							"pm.collectionVariables.set(\"especialidade\", especialidades[Math.floor(Math.random() * especialidades.length)]);",
							"pm.collectionVariables.set(\"registroFuncional\", gerarRegistro());",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Recupera o CPF gerado no Pre-request Script",
							"const cpfMecanico = pm.collectionVariables.get(\"cpf_mecanico\") || pm.environment.get(\"cpf_mecanico\");",
							"",
							"// Regrava para garantir persistência",
							"pm.collectionVariables.set(\"cpf_mecanico\", cpfMecanico);",
							"",
							"// Opcional: logar no console para verificar",
							"console.log(\"CPF do mecânico mantido:\", cpfMecanico);",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
