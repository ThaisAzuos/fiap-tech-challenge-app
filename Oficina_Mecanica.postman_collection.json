					"    // Percorre todas as variáveis da collection",
					"    Object.keys(pm.collectionVariables.toObject()).forEach(key => {",
					"        if (key !== \"baseURL\") {",
					"            pm.collectionVariables.set(key, \"\");",
					"        }",
					"    });",
					"",
					"    console.log(\"Variáveis resetadas, exceto baseURL\");",
					"} else {",
					"    console.log(\"Execução isolada, não resetando variáveis\");",
