	"item": [
		{
			"name": "1. Cadastrar Cliente",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Captura o corpo da resposta",
							"let response = pm.response.json();",
							"",
							"// Se o campo for \"cpf\"",
							"if (response.cpf) {",
							"    pm.collectionVariables.set(\"cpf_cliente\", response.cpf);",
							"    console.log(\"CPF salvo:\", response.cpf);",
							"}",
							"",
							"// Se o campo for \"cpfDono\"",
							"if (response.cpfDono) {",
							"    pm.collectionVariables.set(\"cpf_cliente\", response.cpfDono);",
							"    console.log(\"CPF do dono salvo:\", response.cpfDono);",
							"}",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"function gerarCpf() {",
							"    let cpfArray;",
							"    do {",
							"        const nums = [];",
							"        for (let i = 0; i < 9; i++) {",
							"            nums.push(Math.floor(Math.random() * 10));",
							"        }",
							"        const dig1 = calcularDigito(nums);",
							"        const dig2 = calcularDigito([...nums, dig1]);",
							"        cpfArray = [...nums, dig1, dig2];",
							"    } while (sequenciaInvalida(cpfArray));",
							"    return { semPontuacao: cpfArray.join('') };",
							"}",
							"",
							"function calcularDigito(digs) {",
							"    let soma = 0;",
							"    for (let i = 0; i < digs.length; i++) {",
							"        soma += digs[i] * ((digs.length + 1) - i);",
							"    }",
							"    const resto = soma % 11;",
							"    return resto < 2 ? 0 : 11 - resto;",
							"}",
							"",
							"function sequenciaInvalida(cpfArray) {",
							"    return cpfArray.every(d => d === cpfArray[0]);",
							"}",
							"",
							"// Lista de nomes possíveis",
							"const nomesClientes = [",
							"    \"João da Silva\",",
							"    \"Maria Oliveira\",",
							"    \"Carlos Pereira\",",
							"    \"Ana Souza\",",
							"    \"Roberto Lima\",",
							"    \"Fernanda Costa\",",
							"    \"Paulo Henrique\",",
							"    \"Mariana Torres\",",
							"    \"Lucas Almeida\",",
							"    \"Patrícia Gomes\"",
							"];",
							"",
							"// Seleciona nome aleatório",
							"const nomeCliente = nomesClientes[Math.floor(Math.random() * nomesClientes.length)];",
							"",
							"// Gera e-mail baseado no nome",
							"function gerarEmail(nome) {",
							"    return nome.toLowerCase()",
							"               .replace(/\\s+/g, '')   // remove espaços",
							"               .normalize(\"NFD\")      // remove acentos",
							"               .replace(/[\\u0300-\\u036f]/g, '') ",
							"               + \"@email.com.br\";",
							"}",
							"const emailCliente = gerarEmail(nomeCliente);",
							"",
							"// Gera telefone aleatório (DDD + número)",
							"function gerarTelefone() {",
							"    const ddd = Math.floor(Math.random() * 90) + 10; // DDD entre 10 e 99",
							"    const prefixo = Math.floor(Math.random() * 9000) + 1000; // 4 dígitos",
							"    const sufixo = Math.floor(Math.random() * 9000) + 1000;  // 4 dígitos",
							"    return ddd + prefixo + sufixo;",
							"}",
							"const telefoneCliente = gerarTelefone();",
							"",
							"// Gerar CPF",
							"const cpf = gerarCpf();",
							"",
							"// Armazenar nas variáveis da collection",
							"pm.collectionVariables.set(\"cpf_valido\", cpf.semPontuacao);",
							"pm.collectionVariables.set(\"nome_cliente\", nomeCliente);",
							"pm.collectionVariables.set(\"email_cliente\", emailCliente);",
							"pm.collectionVariables.set(\"telefone_cliente\", telefoneCliente);",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"nome\": \"{{nome_cliente}}\",\n  \"cpf\": \"{{cpf_valido}}\",\n  \"email\": \"{{email_cliente}}\",\n  \"telefone\": \"{{telefone_cliente}}\",\n  \"endereco\": {\n    \"logradouro\": \"Rua das Flores\",\n    \"numero\": \"123\",\n    \"complemento\": \"Apto 1\",\n    \"bairro\": \"Centro\",\n    \"cidade\": \"São Paulo\",\n    \"uf\": \"SP\",\n    \"cep\": \"01234567\"\n  }\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseURL}}/api/v1/clientes",
					"host": [
						"{{baseURL}}"
					],
					"path": [
						"api",
						"v1",
						"clientes"
					]
				}
			},
			"response": []
		},
		{
			"name": "2. Cadastrar Veículo",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"function gerarPlaca() {",
							"    const letras = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\";",
							"    const numeros = \"0123456789\";",
							"    const parte1 = Array.from({length: 3}, () => letras[Math.floor(Math.random() * letras.length)]).join('');",
							"    const parte2 = numeros[Math.floor(Math.random() * numeros.length)];",
							"    const parte3 = letras[Math.floor(Math.random() * letras.length)];",
							"    const parte4 = Array.from({length: 2}, () => numeros[Math.floor(Math.random() * numeros.length)]).join('');",
							"    return parte1 + parte2 + parte3 + parte4;",
							"}",
							"",
							"const modelos = [\"Civic\", \"Corolla\", \"Gol\", \"Onix\", \"Fiesta\", \"Uno\"];",
							"const marcas = [\"Honda\", \"Toyota\", \"Volkswagen\", \"Chevrolet\", \"Ford\", \"Fiat\"];",
							"const cores = [\"Prata\", \"Preto\", \"Branco\", \"Vermelho\", \"Azul\", \"Verde\"];",
							"",
							"pm.collectionVariables.set(\"placa\", gerarPlaca());",
							"pm.collectionVariables.set(\"modelo\", modelos[Math.floor(Math.random() * modelos.length)]);",
							"pm.collectionVariables.set(\"marca\", marcas[Math.floor(Math.random() * marcas.length)]);",
							"pm.collectionVariables.set(\"ano\", Math.floor(Math.random() * (2025 - 2000 + 1)) + 2000);",
							"pm.collectionVariables.set(\"cor\", cores[Math.floor(Math.random() * cores.length)]);",
							"",
							"// Recupera o valor já salvo",
							"let cpfCliente = pm.collectionVariables.get(\"cpf_cliente\");",
							"",
							"// Se quiser conferir",
							"console.log(\"CPF recuperado:\", cpfCliente);",
							"",
							"// Você pode setar novamente em variáveis locais se precisar",
							"pm.variables.set(\"cpf_cliente\", cpfCliente);",
							"",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"// recupera a placa usada na requisição",
							"const placa = pm.collectionVariables.get(\"placa\");",
							"",
							"// regrava para garantir persistência",
							"pm.collectionVariables.set(\"placa\", placa);",
							"",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"placa\": \"{{placa}}\",\n  \"modelo\": \"{{modelo}}\",\n  \"marca\": \"{{marca}}\",\n  \"ano\": {{ano}},\n  \"cor\": \"{{cor}}\",\n  \"cpfDono\": \"{{cpf_cliente}}\"\n}\n",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseURL}}/api/v1/veiculos",
					"host": [
						"{{baseURL}}"
					],
					"path": [
						"api",
						"v1",
						"veiculos"
					]
				}
			},
			"response": []
