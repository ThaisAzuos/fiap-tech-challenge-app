		{
			"name": "5. Realizar Agendamento",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Lê o corpo da resposta como JSON",
							"const responseJson = pm.response.json();",
							"",
							"// Recupera o campo \"id\"",
							"const atendimentoId = responseJson.id;",
							"",
							"// Salva em variável da collection (ou ambiente, se preferir)",
							"pm.collectionVariables.set(\"atendimentoId\", atendimentoId);",
							"",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Função para adicionar minutos a uma data",
							"function addMinutes(date, minutes) {",
							"    return new Date(date.getTime() + minutes * 60000);",
							"}",
							"",
							"// Função para adicionar dias a uma data",
							"function addDays(date, days) {",
							"    return new Date(date.getTime() + days * 24 * 60 * 60000);",
							"}",
							"",
							"// Hora atual",
							"const agora = new Date();",
							"",
							"// Hora de início: 30 minutos após agora",
							"const inicio = addMinutes(agora, 30);",
							"",
							"// Hora de fim: entre 1 hora e 5 dias após o início",
							"const maxFim = addDays(inicio, 5);",
							"const fim = new Date(inicio.getTime() + Math.floor(Math.random() * (maxFim.getTime() - inicio.getTime())));",
							"",
							"// Enum de tipos permitidos",
							"const tipos = [\"ANALISE\", \"EXECUCAO\"];",
							"const tipo = tipos[Math.floor(Math.random() * tipos.length)];",
							"",
							"// Formata em ISO 8601 (sem timezone)",
							"function formatISO(date) {",
							"    return date.toISOString().split('.')[0];",
							"}",
							"",
							"// Define variáveis na collection",
							"pm.collectionVariables.set(\"dataHoraInicio\", formatISO(inicio));",
							"pm.collectionVariables.set(\"dataHoraFim\", formatISO(fim));",
							"pm.collectionVariables.set(\"tipo\", tipo);",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"clienteId\": \"{{cpf_cliente}}\",\n  \"veiculoId\": \"{{placa}}\",\n  \"recursoId\": \"{{cpf_mecanico}}\",\n  \"dataHoraInicio\": \"{{dataHoraInicio}}\",\n  \"dataHoraFim\": \"{{dataHoraFim}}\",\n  \"tipo\": \"{{tipo}}\"\n}\n",
