{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fiap-tech-challenge/eventos/OrcamentoGerado.schema.json",
  "title": "OrcamentoGerado",
  "description": "Publicado pelo Billing Service ao gerar o orçamento de uma OS. Routing key: orcamento.gerado",
  "type": "object",
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "sagaId", "ordemServicoId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "OrcamentoGerado" },
    "eventVersion": { "type": "string", "example": "1.0" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "sagaId": { "type": "string", "format": "uuid" },
    "ordemServicoId": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "required": ["orcamentoId", "valorTotal", "itens", "validadeAte"],
      "properties": {
        "orcamentoId": { "type": "string", "format": "uuid" },
        "valorTotal": { "type": "number", "minimum": 0 },
        "itens": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["descricao", "valor"],
            "properties": {
              "descricao": { "type": "string" },
              "valor": { "type": "number", "minimum": 0 }
            }
          }
        },
        "validadeAte": { "type": "string", "format": "date-time" }
      }
    }
  }
}
