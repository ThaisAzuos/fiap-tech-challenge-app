{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fiap-tech-challenge/eventos/PagamentoFalhou.schema.json",
  "title": "PagamentoFalhou",
  "description": "Publicado pelo Billing Service quando o pagamento falha ou é recusado. Dispara compensação da Saga. Routing key: pagamento.falhou",
  "type": "object",
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "sagaId", "ordemServicoId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "PagamentoFalhou" },
    "eventVersion": { "type": "string", "example": "1.0" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "sagaId": { "type": "string", "format": "uuid" },
    "ordemServicoId": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "required": ["orcamentoId", "motivo"],
      "properties": {
        "orcamentoId": { "type": "string", "format": "uuid" },
        "motivo": { "type": "string" },
        "mercadoPagoStatusDetail": { "type": "string", "description": "status_detail retornado pela API do Mercado Pago, quando aplicável" }
      }
    }
  }
}
