{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fiap-tech-challenge/eventos/OrcamentoAprovado.schema.json",
  "title": "OrcamentoAprovado",
  "description": "Publicado pelo Billing Service quando o cliente aprova o orçamento. Routing key: orcamento.aprovado",
  "type": "object",
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "sagaId", "ordemServicoId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "OrcamentoAprovado" },
    "eventVersion": { "type": "string", "example": "1.0" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "sagaId": { "type": "string", "format": "uuid" },
    "ordemServicoId": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "required": ["orcamentoId", "aprovadoEm"],
      "properties": {
        "orcamentoId": { "type": "string", "format": "uuid" },
        "aprovadoEm": { "type": "string", "format": "date-time" },
        "aprovadoPor": { "type": "string", "description": "Identificador do cliente ou canal que aprovou" }
      }
    }
  }
}
