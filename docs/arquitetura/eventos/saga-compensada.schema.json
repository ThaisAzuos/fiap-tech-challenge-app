{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fiap-tech-challenge/eventos/SagaCompensada.schema.json",
  "title": "SagaCompensada",
  "description": "Publicado pelo orquestrador (OS Service) quando a Saga é compensada após uma falha em qualquer etapa. Routing key: saga.compensada",
  "type": "object",
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "sagaId", "ordemServicoId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "SagaCompensada" },
    "eventVersion": { "type": "string", "example": "1.0" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "sagaId": { "type": "string", "format": "uuid" },
    "ordemServicoId": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "required": ["etapaFalha", "motivoCompensacao"],
      "properties": {
        "etapaFalha": { "type": "string", "enum": ["ORCAMENTO", "PAGAMENTO", "EXECUCAO"] },
        "motivoCompensacao": { "type": "string" },
        "acoesCompensatorias": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Lista de ações de compensação esperadas de cada serviço consumidor (ex.: estornar orçamento, liberar posição na fila de execução)"
        }
      }
    }
  }
}
